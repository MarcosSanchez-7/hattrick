# Copia este fichero como .env.local y rellena los valores reales.

# Supabase -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave privilegiada de servidor. NUNCA con prefijo NEXT_PUBLIC_, nunca en el cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Vercel -> proyecto -> Storage -> crear un Blob store y conectarlo.
# En despliegues de Vercel se inyecta solo; en local hay que copiarla aquí.
BLOB_READ_WRITE_TOKEN=
