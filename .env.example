# Copia este fichero como .env.local y rellena los valores reales.

# URL pública del sitio (sin barra final). Se usa para SEO: metadataBase,
# canonical, sitemap.xml y JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.hattrickpy.com

# Supabase -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=

# Clave privilegiada de servidor. NUNCA con prefijo NEXT_PUBLIC_, nunca en el cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Firma la cookie de sesión del admin (lib/admin-auth.ts). Cualquier string
# largo y aleatorio — ej. `openssl rand -base64 32`. Cambiarlo cierra todas
# las sesiones activas.
ADMIN_SESSION_SECRET=

# Opcional. Si se define, /gestion-ssjblue/setup exige este valor además de
# que no exista ningún admin todavía — cierra la ventana de un primer
# despliegue con la base vacía. Dejar vacío mantiene el comportamiento de
# siempre (solo se exige que no haya admins creados).
SETUP_TOKEN=

# Vercel -> proyecto -> Storage -> crear un Blob store y conectarlo.
# En despliegues de Vercel se inyecta solo; en local hay que copiarla aquí.
BLOB_READ_WRITE_TOKEN=

# Rate limiting (lib/rate-limit.ts). Cuenta gratis en upstash.com -> crear
# una base Redis -> copiar estos dos valores desde su dashboard. Si se
# dejan vacíos, el rate limiting queda desactivado (no rompe el sitio).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
